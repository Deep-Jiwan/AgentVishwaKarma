{
  "name": "deepjiwan",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": { "ADMIN_NAME": "Deep Jiwan", "BRAND_NAME": "Deep Jiwan" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vishwakarma-calendar",
      "database_id": "c0a09d02-8821-4b62-ad68-249d1568079d"
    }
  ]
}
